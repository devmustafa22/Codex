{
  "name": "madar-personal-dashboard",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "vitest run",
    "test:e2e": "playwright test && playwright test --config playwright.cloud.config.ts",
    "test:backend": "node --experimental-strip-types --test supabase/tests/login-helpers.test.ts supabase/tests/admin-handler.test.ts",
    "test:db": "bash supabase/tests/run-db-tests.sh",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@fontsource/ibm-plex-sans-arabic": "^5.2.8",
    "@supabase/supabase-js": "^2.117.2",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "prettier": "^3.9.9",
    "typescript": "^5.7.2",
    "vite": "^6.0.5",
    "vitest": "^3.0.0",
    "wrangler": "4.148.0"
  },
  "engines": {
    "node": ">=22"
  }
}
